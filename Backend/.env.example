# Copy to Backend/.env and adjust. Never commit the real .env.
DJANGO_DEBUG=true
# Required when DJANGO_DEBUG=false. Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database: postgres (target) or sqlite (quick local tests only)
DB_ENGINE=postgres
DB_NAME=worldweaver
DB_USER=worldweaver
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=5432
# SQLITE_NAME=db.sqlite3

# Frontend origins (Vite dev server)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local AI (Ollama). Only loopback hosts are allowed unless listed in OLLAMA_ALLOWED_HOSTS.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_ALLOWED_HOSTS=
OLLAMA_TIMEOUT_SECONDS=180
OLLAMA_NUM_CTX=8192
AI_MAX_CONCURRENT_JOBS=1

# Spellchecking: folder with uk_UA.aff and uk_UA.dic
# SPELL_DICT_DIR=D:\path\to\dictionaries

# Private uploads (portraits) — not served publicly
# MEDIA_ROOT=D:\path\to\private_media
LOG_LEVEL=INFO
